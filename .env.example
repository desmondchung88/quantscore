# Copy this file to .env and fill in your own values.
# .env is git-ignored; .env.example is the one that gets committed.

# ---- Relational database ----
# Default: the MySQL container from docker-compose.yml on port 3307.
# Nothing to set up -- "docker compose up -d" and it is ready.
#
# To use a local MySQL/MariaDB instead: comment out the mysql service in
# docker-compose.yml, run
#     mysql -u root -p < backend/sql/00_create_user.sql
# and switch to port 3306 with user/password quantscore. (On Windows,
# MariaDB's root authenticates through Windows SSPI, which the Python
# driver cannot use -- see README section 3.)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=quantscore
MYSQL_DB=quantscore

# ---- Document database (MongoDB) ----
MONGO_URI=mongodb://localhost:27017
MONGO_DB=quantscore

# ---- API ----
# Generate your own before any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-you-demo-this
JWT_EXPIRE_MINUTES=720
TRADE_FEE_RATE=0.0005
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- ETL ----
# Folder that contains the extracted Kaggle datasets. The loader searches
# this folder and two levels below it, so the "archive (3)" / "archive (4)"
# / "archive (5)" names from Kaggle work as-is.
DATA_DIR=..
PRICE_START_DATE=2018-01-01
PRICE_END_DATE=2023-12-31
NEWS_MAX_ROWS=1200000
